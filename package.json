{
    "name": "bidrag-reisekostnad-ui",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=24.22.1 <25"
    },
    "scripts": {
        "dev": "next dev | pino-pretty",
        "dev:mock": "cross-env NEXT_PUBLIC_API_MOCKING=true npm run dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint -- --fix .",
        "type-check": "tsc --project tsconfig.json --pretty --noEmit",
        "prepare": "husky",
        "test:ci": "vitest --config vitest.config.mts",
        "test": "vitest --config vitest.config.mts",
        "coverage": "vitest run --config vitest.config.mts --coverage"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "prettier --list-different",
            "eslint --max-warnings 0"
        ]
    },
    "browser": {
        "fs": false,
        "path": false,
        "os": false
    },
    "dependencies": {
        "@navikt/aksel-icons": "^8.20.0",
        "@navikt/ds-css": "^8.20.0",
        "@navikt/ds-react": "^8.20.0",
        "@navikt/ds-tailwind": "^8.20.0",
        "@navikt/nav-dekoratoren-moduler": "^4.5.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@tanstack/react-query": "^5.104.5",
        "dayjs": "^1.11.23",
        "env-var": "^7.5.0",
        "html-react-parser": "^6.1.9",
        "i18next": "^26.5.5",
        "iovalkey": "^0.4.0",
        "jose": "^4.15.5",
        "lodash.memoize": "^4.1.2",
        "msw": "^3.0.3",
        "next": "^16.4.2",
        "next-i18next": "^16.4.1",
        "node-cache": "^5.1.2",
        "openid-client": "^5.4.3",
        "pino": "^10.4.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.1",
        "swr": "^2.5.1",
        "uuid": "^14.0.3"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@navikt/aksel": "^8.20.0",
        "@next/eslint-plugin-next": "^16.4.2",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/lodash.memoize": "^4.1.9",
        "@types/node": "^24.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "cross-env": "^10.1.0",
        "eslint": "^10.13.0",
        "eslint-config-next": "^16.4.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest-dom": "^5.10.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-testing-library": "^7.16.2",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.4.1",
        "pino-pretty": "^13.2.0",
        "postcss": "^8.5.31",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.2.1",
        "typescript": "^5.9.3",
